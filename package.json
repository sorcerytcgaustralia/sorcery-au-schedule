{
  "name": "realmofoz",
  "private": true,
  "description": "Sorcery TCG Australia community site, built with Next.js and deployed to Cloudflare Workers static assets",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/fetch-data.ts",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
