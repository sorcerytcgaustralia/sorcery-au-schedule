{
  // Cloudflare Workers static assets config for realmofoz.com.
  // No Worker script: `next build` writes a fully static site to ./out
  // (output: 'export' in next.config.ts) and Cloudflare serves it as is.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realmofoz",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./out",
    // Multi-page static site, not a client-routed SPA: unknown paths get
    // Next's exported 404.html with a real 404 status.
    "not_found_handling": "404-page"
  }
}
