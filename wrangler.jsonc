{
  // Cloudflare Workers static assets config for realmofoz.com.
  // No Worker script: the site is plain static HTML/CSS/JS, so Cloudflare
  // serves the files directly from the assets directory below.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realmofoz",
  "compatibility_date": "2026-09-08",
  "assets": {
    // The repo root is the deploy artifact: there is no build step.
    // .assetsignore (gitignore syntax) keeps repo housekeeping files out
    // of the upload.
    "directory": "./",
    // Multi-page static site, not a client-routed SPA: unknown paths get
    // the styled 404.html with a real 404 status.
    "not_found_handling": "404-page"
  }
}
